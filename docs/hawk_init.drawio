<mxfile host="drawio" version="26.0.0">
  <diagram name="INIT" id="init">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="860">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="INIT + RUNTIME  ·  supervisors, workers и их очереди" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=18;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Синий — supervisor. Оранжевый — worker process. Жёлтый — очередь. Отдельного rate limiter нет: один синхронный HTTP Worker = максимум один request in-flight." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1100" height="30" as="geometry" />
        </mxCell>

        <mxCell id="4" value="hawk.init" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="90" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="5" value="Root Supervisor&#xa;static_supervisor · OneForAll" style="swimlane;startSize=36;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="1120" height="640" as="geometry" />
        </mxCell>

        <mxCell id="6" value="Worker Supervisor&#xa;factory_supervisor · named" style="swimlane;startSize=40;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="5">
          <mxGeometry x="30" y="50" width="520" height="560" as="geometry" />
        </mxCell>

        <mxCell id="7" value="HTTP Worker · один process" style="swimlane;startSize=34;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="6">
          <mxGeometry x="80" y="50" width="360" height="420" as="geometry" />
        </mxCell>
        <mxCell id="8" value="Q3 · worker mailbox&#xa;WorkerMessage: ProcessEvent&#xa;обычно 0..1 message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="7">
          <mxGeometry x="30" y="55" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="10" value="handle ProcessEvent&#xa;httpc.send синхронно&#xa;&#xa;1 worker = max 1 concurrent request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="7">
          <mxGeometry x="30" y="165" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="10b" value="default httpc profile → k1.hawk.so&#xa;keep-alive может reuse или пересоздать TCP connection&#xa;отдельный connection limit сейчас не нужен" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="7">
          <mxGeometry x="30" y="285" width="300" height="90" as="geometry" />
        </mxCell>

        <mxCell id="11" value="Dispatcher Worker · named hawk_gleam_dispatcher" style="swimlane;startSize=40;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="5">
          <mxGeometry x="600" y="50" width="480" height="560" as="geometry" />
        </mxCell>
        <mxCell id="12" value="Dispatcher State&#xa;integration_token · generated default_user · default transport&#xa;worker subject + Free|Busy" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff7ed;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="11">
          <mxGeometry x="20" y="50" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="12b" value="Q1 · dispatcher mailbox&#xa;Enqueue · WorkerReady · WorkerOnline&#xa;unbounded Erlang inbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="11">
          <mxGeometry x="20" y="145" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="21" value="Q2 · State.pending&#xa;FIFO List(Event) · max 100&#xa;сюда Event попадает, если worker Busy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="11">
          <mxGeometry x="240" y="145" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="22" value="inflight slot · worker.current&#xa;None = Free · Some(Event) = Busy&#xa;не очередь: ровно 0..1 Event" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="11">
          <mxGeometry x="20" y="275" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="19" value="Snapshot copy · persistent_term&#xa;default_user + transport + pending + inflight&#xa;восстановление после restart Dispatcher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="11">
          <mxGeometry x="240" y="275" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="20" value="handle Enqueue: validate + create Event&#xa;Free → сразу current · Busy → append pending&#xa;commit snapshot перед ProcessEvent" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#8a4b08;" vertex="1" parent="11">
          <mxGeometry x="100" y="405" width="280" height="90" as="geometry" />
